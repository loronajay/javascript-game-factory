AGENTS.md
CLAUDE.md
SKILLS.md
games/*/GDD.md
games/*/docs/

# A developer's own music folder. Speed Demon Radio points at whatever folder the
# player picks at runtime; a local copy sitting in the cabinet is convenience, not
# shipped content, and it is other people's music.
games/*/my-radio/

# Local test/dev harnesses should not ship
*.test.js
*.test.mjs
__tests__/
tests/
dev/
!games/*/*.test.js
!games/*/*.test.mjs
!games/*/tests/
!games/*/tests/**

# Ship the repo-wide README coverage/freshness regression.
!js/tests/
js/tests/*
!js/tests/readme-freshness.test.mjs

# Keep the database regression that prevents narrow profile updates from
# erasing canonical fields after an origin/domain change.
!platform-api/tests/
platform-api/tests/*
!platform-api/tests/profiles-db.test.mjs
!platform-api/tests/ownership-backfill-security.test.mjs
!platform-api/tests/rating-routes-security.test.mjs
!platform-api/tests/stripe-checkout-security.test.mjs

# Echo Duel keeps its local regression tests out of shipped game builds.
games/echo-duel/tests/
games/echo-duel/tests/**

# Circuit Siege ships without its local TDD suite or debug demo folder.
games/circuit-siege/tests/
games/circuit-siege/tests/**
games/circuit-siege/circuit_siege_debug_demo_v0_5/
games/circuit-siege/circuit_siege_debug_demo_v0_5/**

# Mobile emulation harness output (regenerated by npm run mobile:shots).
games/tactical-arena/.mobile-shots/

# Speed Demon's driver-avatar masters: 49 1254x1254 PNGs, ~117MB.
#
# Nothing serves them. `tools/make-face-thumbs.py` derives the two sizes the game
# actually draws — `<group>/thumbs/*.jpg` (256px) and `<group>/cards/*.jpg`
# (768px), under a megabyte and 6MB respectively — and those ARE tracked, because
# they are what the site loads. Keeping the masters out keeps ~117MB of art the
# browser never requests out of every clone.
#
# The masters are the artist's originals and still live in the working copy: the
# tool reads them, and a future surface may want a face larger than the VS card
# does. They need a backup that is not this repo. A clone without them is a
# complete, playable cabinet — the tests that need a master skip when it is
# absent and the ones covering the derived files do not.
#
# The ten rival portraits under assets/characters/ stay tracked: they are already
# in the history, so ignoring them now would remove them from checkouts without
# making the repo any smaller.
games/speed-demon/assets/avatars/*/*.png
