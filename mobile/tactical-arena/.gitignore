# Generated by scripts/build-www.mjs from the live web sources. Never edit by
# hand and never commit — games/tactical-arena/ is the source of truth.
www/

node_modules/

# Capacitor copies www/ into here on every sync.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Gradle build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/

*.apk
*.aab
*.keystore
*.jks

# Release signing material. Committing either of these hands over the ability to publish
# updates as you. Back them up outside the repo — a lost upload key is a support ticket.
android/keystore.properties

# Persistent cache for optimized payload images (see scripts/optimize-images.mjs).
.asset-cache/

# Screenshots and previews pulled off a device / emulator by scripts/verify-android.mjs.
.device-shots/

# Generated product list for the Play Console (regenerate: node scripts/play-products-report.mjs --tsv).
play-products.tsv

# Google service-account keys must never be committed.
*service-account*.json
play-service-account.json
